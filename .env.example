# Copy to .env and replace placeholders. Keep .env private.
# Run bash install.sh after changing serving options; start.sh uses installed settings.
# Use an absolute data directory; Docker preserves the same paths for Engram reads.
STRATA_DATA_DIR=/path/to/strata-data
# Optional overrides; otherwise the launchers use .venv and tools on PATH.
# DS41_PYTHON=/path/to/python
# DS41_CMAKE=/path/to/cmake
# DS41_NINJA=/path/to/ninja
# CUDACXX=/path/to/nvcc
# Put the heavier first stage on the card with more available VRAM.
DS41_CUDA_VISIBLE_DEVICES=0,1
# Physical monitoring IDs, independent of the CUDA visibility order.
DS41_TELEMETRY_GPUS=0,1
