# Copy to .env and replace placeholders. Keep .env private.
# Run bash install.sh after changing serving options; start.sh uses installed settings.
# Use an absolute data directory containing the existing 2.9 model and Maya pack.
STRATA_DATA_DIR=/path/to/strata-data
# Point these at an existing pinned Maya checkout, binary and pack.
MAYA_SOURCE_DIR=/path/to/project-maya
MAYA_ENGINE=/path/to/strata-data/builds/project-maya-249f9a87-sm120/maya-ds4
MAYA_PACK_DIR=/path/to/strata-data/packs/project-maya-249f9a87-libertaidai-29
# Optional overrides; otherwise the launchers use .venv and tools on PATH.
# MAYA_PYTHON=/path/to/python
# DS41_PYTHON=/path/to/python
# DS41_CMAKE=/path/to/cmake
# DS41_NINJA=/path/to/ninja
# CUDACXX=/path/to/nvcc
# Put the heavier first stage on the card with more available VRAM.
DS41_CUDA_VISIBLE_DEVICES=0,1
# 32K is the initial configured capacity; actual long prompts remain unqualified.
MAYA_CONTEXT=32768
MAYA_SPEC=on
# Optional API key; leave unset only for loopback-only access.
# STRATA_API_KEY=replace-with-a-private-key
